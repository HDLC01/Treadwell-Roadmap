# ─── Treadwell Systems Showcase — backend environment (copy to .env) ───────
# .env is gitignored. Never commit real secrets.

# ─── Database (dockerized Postgres) ────────────────────────────────────────
# Password for the dockerized Postgres (used by BOTH the app and db services).
POSTGRES_PASSWORD=change-me-strong

# Full SQLAlchemy URL. In docker-compose this is composed from POSTGRES_PASSWORD
# and the `db` service host. For LOCAL host-run dev (uvicorn on your machine):
#   postgresql+psycopg://roadmap:change-me-strong@127.0.0.1:5433/roadmap
DATABASE_URL=postgresql+psycopg://roadmap:change-me-strong@127.0.0.1:5433/roadmap

# ─── Auth — reuse Treadwell's Supabase / Google sign-in (Proposal Tool's) ──
# From the Supabase project: Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public anon key — safe to expose to the SPA>
# Legacy HS256 JWT secret (Settings → API → JWT Secret). Used as a verification
# fallback if the project isn't using asymmetric (JWKS) signing keys.
SUPABASE_JWT_SECRET=<jwt secret>
# Only @this-domain emails may sign in.
AUTH_ALLOWED_DOMAIN=wetreadwell.com
# Emails granted the admin role on first login (comma-separated).
ADMIN_EMAILS=hanz@wetreadwell.com

# NOTE: In the Supabase project, add the app origin to Authentication →
# URL Configuration → Redirect URLs:  http://localhost:5174  (dev) and
# https://roadmap.wetreadwell.com  (prod). Google provider must be enabled.

# ─── Environment / CORS ────────────────────────────────────────────────────
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8892
CORS_ORIGINS=http://localhost:5174,http://localhost:8892

# ─── Seeding ───────────────────────────────────────────────────────────────
RUN_SEED=true
